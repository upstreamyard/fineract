#!/bin/sh
# Docker HEALTHCHECK: Fineract's readiness endpoint. Uses the same port and scheme rules as
# docker-entrypoint.sh: HTTPS on 8443 by default, HTTP on 8080 with
# FINERACT_SERVER_SSL_ENABLED=false, or FINERACT_SERVER_PORT.
if [ "$(printf '%s' "${FINERACT_SERVER_SSL_ENABLED:-true}" | tr '[:upper:]' '[:lower:]')" = false ]; then
  url="http://127.0.0.1:${FINERACT_SERVER_PORT:-8080}"
else
  url="https://127.0.0.1:${FINERACT_SERVER_PORT:-8443}"
fi
exec curl -fsk -o /dev/null --max-time 4 "$url${FINERACT_SERVER_SERVLET_CONTEXT_PATH:-/fineract-provider}/actuator/health/readiness"
